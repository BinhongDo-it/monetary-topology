__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.venv/
venv/
.env
# Case matters here: the files on disk are HANDOFF_B8.md and friends, and the
# lowercase pattern only ever matched because Windows git defaults to
# core.ignorecase=true. On the Linux CI runner it does not, so four handoff
# files would have shown up as untracked. Both cases are listed on purpose.
*handoff*.md
HANDOFF*.md
*HANDOFF*.md

# Raw data is not redistributed. data/SOURCES.md records where to get it.
# 3.8 GB across three programmes, and the retrieval script rebuilds it.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# The manifests are the exception, and they are committed on purpose. Each
# records, per file, the exact URL queried, the timestamp, and how many rows were
# kept and dropped and why. That is the evidence that the sample was fixed before
# any result was seen, it is the one part of the retrieval a reader cannot
# reconstruct after the fact, and it is under a megabyte for all three.
!data/raw/*_manifest.json

# Figures and results ARE committed: they are the artefact.
!figures/*.png
!results/*.json

# Reduced runs live here, in their own directory, so a smoke run can never be
# read as a stage's record: the directory is the separation. They are committed
# anyway, because a smoke run that disagrees with the full one is the thing you
# want in the history rather than out of it.
!results/subset/*.json

.DS_Store
.idea/
.vscode/

# Superseded pre-registrations and fixtures. This repository does not delete:
# a recursive delete once destroyed hours of retrieval, so anything no longer
# read is renamed with this suffix and left where it is.
*.expired
*.expired[0-9]
# Dated variant, which the fingerprints arm already uses:
# <name>.expired_<yyyymmdd>_pre_<tag>. Added 2026-08-15 after two A7
# backups sat in the untracked list waiting to be committed by accident.
*.expired_*

# Prepared commit messages, not part of the repository.
COMMIT_MSG*.txt

# Git scratch for a single stage: prepared add-lists and how-to notes, written
# for one commit and not part of the repository. COMMIT_MSG*.txt and HANDOFF*.md
# were already excluded and these were not, so `git add -A` would have swept
# them in. Found 2026-08-18 while auditing what an outside reader would see.
GIT_HOWTO*.md
GIT_ADD*.txt
GIT_REWRITE*
b8_paths.txt

# Retired out of the repository rather than deleted, because this repository
# does not delete. Nothing here is on any code path.
_to_delete/

# ---------------------------------------------------------------------------
# Per-stage exclusions. Read this before adding one.
#
# The test is a PROPERTY OF THE FILE, never a state of the stage. "This stage
# has not closed yet", "its register is held elsewhere", "it has no section in
# RESULTS.md" are all states, and states go stale while the rule that quotes
# them does not. Whoever reads such a rule later cannot tell whether it still
# holds without re-deriving it, which is the cost this paragraph exists to
# prevent.
#
# That is not hypothetical. A rule here once kept an entire stage's code and
# records out on the ground that it had no section in RESULTS.md. It then
# closed and reported 422 marker rows across 227 issuers in RESULTS.md, and the
# rule went on excluding the very script that produced those numbers, because
# nothing makes a rule notice that its premise expired. Removed 2026-08-22
# after re-deriving it by hand: the second time anyone had to.
#
# An unfinished stage is not a reason to exclude anything. Its records ship
# carrying `diagnostic_only` and a `diagnostic_reason` that says in plain words
# which readings are not yet the stage's own. That is the mechanism for
# incompleteness, and it is already running.
#
# So a rule below is well formed only if it names a file that is not a stage's
# reading and never will be: a hand-made backup, a subset run, a scratch file,
# a cache that rebuilds from raw. If the reason cannot be written without
# describing what some stage is currently doing, the rule is the wrong shape.
# ---------------------------------------------------------------------------

# B10. Never the stage's reading, by construction rather than by timing. The
# first rule catches the hand-made backups taken before a mechanism changed;
# the second and third catch subset runs, whose file names carry the vintages
# they cover, so their numbers answer a narrower question than the stage's.
results/b10_*.json.*
results/b10_*.pre*.json
results/b10_*.[0-9][0-9][0-9][0-9]*.json

# B14 的派生面板缓存（data/cache/b14/panel_*.csv，约 60 MB）。
# 与 data/raw/* 同理：可从原始 .gzip 两分钟重建，不进仓库。
# 重建：python experiments/b14_tickpilot_panel.py --build
data/cache/

# B8 打包器的逐步日志。它们是一次运行的痕迹，不是产物：
# 重跑即覆盖，且内容里带机器与时长。产物是 results/b8_*.md 与 b8_verdicts.json。
results/_b8_package_log/
